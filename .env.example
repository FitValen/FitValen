# Copia este archivo como .env únicamente en la VPS.
# Genera la clave con: openssl rand -base64 32
FITVALEN_ENCRYPTION_KEY=

# Las dos únicas cuentas iniciales. Los PIN no se escriben en GitHub.
FITVALEN_ADMIN_USERNAME=admin
FITVALEN_ADMIN_NAME=Administrador
FITVALEN_ADMIN_PIN=
FITVALEN_MEMBER_USERNAME=miembro
FITVALEN_MEMBER_NAME=Miembro
FITVALEN_MEMBER_PIN=
